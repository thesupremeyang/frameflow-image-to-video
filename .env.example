# 推荐直接在网页右上角“模型配置”中填写，保存后立即生效。
# 此文件仅作为环境变量默认值的高级配置方式。
# 复制为 .env，填入自己的密钥。不要将 .env 分享或提交到版本库。
ARK_API_KEY=
MINIMAX_API_KEY=

# 使用 MiniMax 中国内地平台时改为 https://api.minimaxi.com
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MINIMAX_BASE_URL=https://api.minimax.io

# 可用环境变量覆盖账号实际开通的模型 ID。
ARK_MODEL_SEEDANCE_2_5=doubao-seedance-2-5-260628
ARK_MODEL_SEEDANCE_2_0=doubao-seedance-2-0-260128
MINIMAX_MODEL=MiniMax-H3

# MiniMax H3 本地图片需要公开 HTTPS URL。支持 AWS S3、Cloudflare R2 等兼容服务。
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=https://media.example.com
S3_PREFIX=frameflow

# 可选：限制代理下载的视频域名，多个后缀用英文逗号分隔。
DOWNLOAD_HOST_SUFFIXES=volces.com,minimax.io,minimaxi.com,aliyuncs.com,myqcloud.com
MAX_VIDEO_BYTES=524288000
TASK_TIMEOUT_SECONDS=7200
